{
  "name": "mertaydin/laravel-queue-monitor",
  "description": "Monitor and manage Laravel queue connections with a driver-aware dashboard.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/queue": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "laravel/pint": "^1.0",
    "larastan/larastan": "^2.9 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "MertAydin\\LaravelQueueMonitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MertAydin\\LaravelQueueMonitor\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MertAydin\\LaravelQueueMonitor\\QueueMonitorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "analyse": "phpstan analyse --no-progress",
    "pint-test": "pint --test"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "homepage": "https://github.com/mertaydin/laravel-queue-monitor",
  "keywords": [
    "laravel",
    "queue",
    "monitoring",
    "supervisor",
    "redis",
    "beanstalkd",
    "amazon-sqs"
  ],
  "support": {
    "issues": "https://github.com/mertaydin/laravel-queue-monitor/issues",
    "source": "https://github.com/mertaydin/laravel-queue-monitor"
  }
}
